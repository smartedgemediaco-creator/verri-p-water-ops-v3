# ─── Database (per-client Atlas account) ─────────────────
# Each client gets their own cluster. Two databases per cluster:
#   water-ops-dev   → you use this when developing locally
#   water-ops-prod  → client's production server uses this
#
# ┌─ Client A ─────────────────────────────────────────┐
# │  Your .env.local:  clusterA/water-ops-dev          │
# │  Prod server env:  clusterA/water-ops-prod         │
# └────────────────────────────────────────────────────┘
#
# ┌─ Client B ─────────────────────────────────────────┐
# │  Your .env.local:  clusterB/water-ops-dev          │
# │  Prod server env:  clusterB/water-ops-prod         │
# └────────────────────────────────────────────────────┘
#
# Database name = path segment after host:
#   mongodb+srv://user:pass@cluster.mongodb.net/water-ops-dev?...
#                                           ^^^^^^^^^^^^^

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string

# ─── LocationIQ (free autocomplete/geocoding — sign up at https://locationiq.com) ──
# Free tier: 10,000 req/day, no credit card required, globally supported (OpenStreetMap data)
NEXT_PUBLIC_LOCATIONIQ_API_KEY=your-locationiq-api-key-here

# ─── Email (SMTP) ─────────────────────────────────────────
# Supports Zoho, Brevo, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@verrip.com.ng
SMTP_PASS=your-app-password
EMAIL_FROM="Verri P Water <noreply@verrip.com.ng>"
APP_URL=http://localhost:3000

# ─── Cron ──────────────────────────────────────────────────
CRON_SECRET=change-this-to-a-random-string

# ─── Webhooks ───────────────────────────────────────────
MONIEPOINT_WEBHOOK_SECRET=change-this-to-your-moniepoint-webhook-secret

# ─── How env files work ─────────────────────────────────
# Tracked in git (placeholders only):
#   .env.development  → loaded by next dev
#   .env.production   → loaded by next start
#
# Gitignored (real credentials):
#   .env.local  → your machine, overrides everything
#
# Production servers: set MONGODB_URI as system env var
# (highest priority, never in any file).
